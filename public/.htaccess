<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options +FollowSymLinks -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 🔐 FORZAR HTTPS Y WWW
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\.viajesatalanta\.com$ [NC]
    RewriteRule ^(.*)$ https://www.viajesatalanta.com/$1 [L,R=301]

    # 🔑 Authorization header (API / JWT)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 🔁 Quitar trailing slash (excepto carpetas reales)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 🛑 NO TOCAR ARCHIVOS NI DIRECTORIOS REALES
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ⚛️ TODAS LAS RUTAS DE REACT → index.php
    RewriteRule ^ index.php [L]

    # 🔐 CABECERAS DE SEGURIDAD
    <IfModule mod_headers.c>
        # Content-Security-Policy (CSP)
        Header set Content-Security-Policy "default-src 'self'; \
            script-src 'self' https://cdn.jsdelivr.net https://code.jquery.com https://cdnjs.cloudflare.com https://cdn.tailwindcss.com; \
            style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.materialdesignicons.com https://cdn.tailwindcss.com; \
            font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdn.materialdesignicons.com https://cdn.jsdelivr.net/npm/remixicon https://cdn.jsdelivr.net/npm/bootstrap-icons https://cdnjs.cloudflare.com; \
            img-src 'self' data: blob: https://images.unsplash.com https://cdn-icons-png.flaticon.com https://viajesatalanta.com https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org; \
            connect-src 'self' https://viajesatalanta.com https://cdn.jsdelivr.net; \
            frame-src 'self' https://www.google.com; \
            child-src 'self' blob:; \
            worker-src blob:; \
            form-action 'self'; \
            base-uri 'self';"

        # HSTS (Strict-Transport-Security)
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Clickjacking protection
        Header always set X-Frame-Options "SAMEORIGIN"

        # MIME type sniffing
        Header always set X-Content-Type-Options "nosniff"

        # Referrer policy
        Header always set Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions policy
        Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

        # Cross-Origin headers
        Header always set Cross-Origin-Opener-Policy "same-origin"
    </IfModule>

    # ===============================
    # CACHE DE RECURSOS ESTÁTICOS
    # ===============================
    <IfModule mod_expires.c>
        ExpiresActive On

        # Imágenes
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/svg+xml "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"

        # Fuentes
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/ttf "access plus 1 year"

        # CSS y JS
        ExpiresByType text/css "access plus 1 month"
        ExpiresByType application/javascript "access plus 1 month"
        ExpiresByType application/x-javascript "access plus 1 month"
    </IfModule>

    <IfModule mod_headers.c>
        # Cache-Control complementario
        <FilesMatch "\.(js|css|png|jpg|jpeg|webp|gif|svg|woff|woff2|ttf)$">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>
    </IfModule>

</IfModule>
